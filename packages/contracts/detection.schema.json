{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/detection.schema.json",
  "title": "DetectionResponse",
  "type": "object",
  "required": ["schema_version", "image", "model", "detections", "timing_ms"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "image": {
      "type": "object",
      "required": ["width", "height"],
      "properties": { "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 } }
    },
    "model": {
      "type": "object",
      "required": ["name", "version"],
      "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
    },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["class_id", "label", "confidence", "bbox"],
        "properties": {
          "class_id": { "type": "integer", "minimum": 0 },
          "label": { "enum": ["with_mask", "without_mask", "mask_worn_incorrectly"] },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "bbox": {
            "type": "object",
            "required": ["x1", "y1", "x2", "y2"],
            "properties": { "x1": { "type": "number" }, "y1": { "type": "number" }, "x2": { "type": "number" }, "y2": { "type": "number" } }
          }
        }
      }
    },
    "timing_ms": {
      "type": "object",
      "required": ["preprocess", "inference", "postprocess"],
      "properties": { "preprocess": { "type": "number" }, "inference": { "type": "number" }, "postprocess": { "type": "number" } }
    }
  }
}

